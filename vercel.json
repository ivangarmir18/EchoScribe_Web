{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://*.supabase.co https://js.stripe.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://generativelanguage.googleapis.com https://api.stripe.com https://va.vercel-scripts.com; frame-src 'self' https://js.stripe.com https://billing.stripe.com https://buy.stripe.com; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/planes", "destination": "/planes.html" },
    { "source": "/precios", "destination": "/planes.html" },
    { "source": "/pro", "destination": "/pro.html" },
    { "source": "/plan-pro", "destination": "/pro.html" },
    { "source": "/ultra", "destination": "/ultra.html" },
    { "source": "/plan-ultra", "destination": "/ultra.html" },
    { "source": "/ajustes", "destination": "/ajustes.html" },
    { "source": "/guias", "destination": "/guias.html" },
    { "source": "/sobre-mi", "destination": "/sobre-mi.html" },
    { "source": "/curriculum", "destination": "/curriculum.html" },
    { "source": "/cv", "destination": "/curriculum.html" },
    { "source": "/recuperar-password", "destination": "/recuperar-password.html" },
    { "source": "/guia-instalacion", "destination": "/guia-instalacion.html" },
    { "source": "/transcribir-youtube", "destination": "/transcribir-youtube.html" },
    { "source": "/transcriptor-audio-a-texto", "destination": "/transcriptor-audio-a-texto.html" },
    { "source": "/terminos-y-condiciones", "destination": "/terminos-y-condiciones.html" },
    { "source": "/politica-privacidad", "destination": "/politica-privacidad.html" },
    { "source": "/politica-cookies", "destination": "/politica-cookies.html" },
    { "source": "/bienvenida", "destination": "/bienvenida.html" },
    { "source": "/transcribir-entrevistas-reuniones", "destination": "/transcribir-entrevistas-reuniones.html" },
    { "source": "/generador-subtitulos-srt", "destination": "/generador-subtitulos-srt.html" },
    { "source": "/guias/:slug", "destination": "/guias/:slug.html" }
  ]
}